{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-sol",
  "small_model": "openai/gpt-6.1-terra",
  "instructions": [
    "AGENTS.md",
    "CONTRIBUTING.md",
    "docs/guidelines.md"
  ],
  "plugin": [
    "oh-my-openagent@latest"
  ],
  "formatter": {
    "scalafmt": {
      "command": [
        "scalafmt",
        "$FILE"
      ],
      "extensions": [
        ".scala",
        ".sc",
        ".sbt"
      ]
    }
  },
  "mcp": {
    "servers": {
      "ista_jira_confluence": {
        "type": "local",
        "command": [
          "node",
          "{env:HOME}/git/rdm/ai/mcp-jira-confluence/dist/index.js",
          "--jira-url",
          "https://ista.atlassian.net",
          "--confluence-url",
          "https://ista.atlassian.net/wiki",
          "--email",
          "gunnar.bastkowski@ista.com",
          "--token-command",
          "pass show ista/jira-api-token-mcp"
        ]
      },
      "akiko": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "github:gbastkowski/mcp-proxy"
        ],
        "environment": {
          "MCP_PROXY_HOST": "akiko"
        }
      },
      "firefox": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@mozilla/firefox-devtools-mcp@latest",
          "--connect-existing",
          "--marionette-port",
          "2829"
        ]
      }
    }
  },
  "provider": {
  },
  "enabled_providers": ["openai"],
  "disabled_providers": [
    "opencode",
    "opencode-go"
  ],
  "experimental": {
    "policies": [
      {
        "effect": "deny",
        "action": "provider.use",
        "resource": "*"
      },
      {
        "effect": "allow",
        "action": "provider.use",
        "resource": "openai"
      },
      {
        "effect": "deny",
        "action": "provider.use",
        "resource": "opencode"
      },
      {
        "effect": "deny",
        "action": "provider.use",
        "resource": "opencode-go"
      }
    ]
  }
}
