{
  "name": "mcp-dotfiles",
  "version": "0.1.0",
  "description": "MCP server exposing the dotfiles bin scripts (apply, system-upgrade) as tools",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json"
  },
  "bin": {
    "mcp-dotfiles": "dist/index.js"
  },
  "keywords": ["mcp", "dotfiles", "home-manager", "nix"],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^22.9.3",
    "tsx": "^4.16.5",
    "typescript": "^5.6.3"
  }
}
