{
  "$schema": "https://opencode.ai/config.json",
  "model": "claude-code/claude-sonnet-5",
  "small_model": "claude-code/claude-haiku-4-5",
  "instructions": [
    "CLAUDE.md",
    "CONTRIBUTING.md",
    "docs/guidelines.md"
  ],
  "plugin": [
    "oh-my-openagent@latest",
    "@khalilgharbaoui/opencode-claude-code-plugin"
  ],
  "tools": {
    "bash": false,
    "glob": false,
    "grep": false,
    "list": false,
    "patch": false,
    "skill": false,
    "todoread": false,
    "todowrite": false,
    "webfetch": false,
    "write": false
  },
  "formatter": {
    "scalafmt": {
      "command": [
        "scalafmt",
        "$FILE"
      ],
      "extensions": [
        ".scala",
        ".sc",
        ".sbt"
      ]
    }
  },
  "mcp": {
    "emacs": {
      "type": "remote",
      "url": "http://localhost:8765/mcp",
      "enabled": true
    },
    "context7": {
      "type": "local",
      "enabled": true,
      "command": [
        "sh",
        "-c",
        "CONTEXT7_API_KEY=\"$(pass show private/context7/api-key)\" exec npx -y @upstash/context7-mcp"
      ]
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen-tools": {
          "name": "Qwen 3.5 9B",
          "tools": true,
          "variants": {
            "none": {},
            "low": {},
            "medium": {},
            "high": {},
            "xhigh": {}
          }
        },
        "qwen-fast": {
          "name": "Qwen 3 4B",
          "tools": true,
          "variants": {
            "none": {},
            "low": {},
            "medium": {},
            "high": {},
            "xhigh": {}
          }
        },
        "qwen-coder": {
          "name": "Qwen Coder 14B",
          "variants": {
            "none": {},
            "low": {},
            "medium": {},
            "high": {},
            "xhigh": {}
          }
        }
      }
    }
  }
}
