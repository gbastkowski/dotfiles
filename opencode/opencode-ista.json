{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-sol",
  "small_model": "openai/gpt-6.1-terra",
  "skills": [
    "~/git/dsp-mdb/ai-tooling/jira-assistant-claude-plugin/skills"
  ],
  "instructions": [
    "AGENTS.md",
    "CONTRIBUTING.md",
    "docs/guidelines.md"
  ],
  "plugin": [
    "oh-my-openagent@latest"
  ],
  "formatter": {
    "scalafmt": {
      "command": [
        "scalafmt",
        "$FILE"
      ],
      "extensions": [
        ".scala",
        ".sc",
        ".sbt"
      ]
    }
  },
  "mcp": {
    "servers": {
      "atlassian": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v2/mcp"
      },
      "akiko": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "github:gbastkowski/mcp-proxy"
        ],
        "environment": {
          "MCP_PROXY_HOST": "akiko"
        }
      },
      "firefox": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@mozilla/firefox-devtools-mcp@latest",
          "--connect-existing",
          "--marionette-port",
          "2829"
        ]
      }
    }
  },
  "provider": {
  },
  "enabled_providers": ["openai"],
  "disabled_providers": [
    "opencode",
    "opencode-go"
  ],
  "experimental": {
    "policies": [
      {
        "effect": "deny",
        "action": "provider.use",
        "resource": "*"
      },
      {
        "effect": "allow",
        "action": "provider.use",
        "resource": "openai"
      },
      {
        "effect": "deny",
        "action": "provider.use",
        "resource": "opencode"
      },
      {
        "effect": "deny",
        "action": "provider.use",
        "resource": "opencode-go"
      }
    ]
  }
}
