#!/usr/bin/env bash
set -euo pipefail

# Control the portable monitor (UPERFECT 16" 2K, BOE J560T09 panel) on or off,
# keeping Hyprland in sync so it stops/starts rendering to it accordingly.
#
# Selected by EDID (mfg/model) so it stays correct regardless of I2C bus order.
# A DDC/CI power-off keeps the HDMI link up, which is invisible to Hyprland, so
# we also enable/disable the Hyprland output explicitly.
#
# Usage: monitor-control <on|off|status>

MFG="BOE"
MODEL="J560T09"
HYPR_OUTPUT="HDMI-A-1"
# Rule Hyprland uses to (re-)enable the output: mode,position,scale.
HYPR_ON_RULE="preferred,-2560x560,1"

usage() {
  echo "Usage: monitor-control <on|off|status>" >&2
  exit 2
}

# Only talk to Hyprland when it's actually running (no-op in the text console).
hyprctl_if_running() {
  pgrep -x Hyprland >/dev/null 2>&1 || return 0
  hyprctl "$@"
}

case "${1:-}" in
  on)
    ddcutil setvcp D6 0x01 --mfg "$MFG" --model "$MODEL"
    hyprctl_if_running keyword monitor "${HYPR_OUTPUT},${HYPR_ON_RULE}"
    ;;
  off)
    hyprctl_if_running keyword monitor "${HYPR_OUTPUT},disable"
    ddcutil setvcp D6 0x05 --mfg "$MFG" --model "$MODEL"
    ;;
  status)
    val="$(ddcutil getvcp D6 --mfg "$MFG" --model "$MODEL" --terse 2>/dev/null | awk '{print $NF}')"
    case "$val" in
      x01)     echo "on" ;;
      x04|x05) echo "off" ;;
      *)       echo "unreachable" >&2; exit 1 ;;
    esac
    ;;
  *)
    usage
    ;;
esac
